# Copy to .env. Never commit real keys.

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# First Administration account. Used only by `npm run auth:bootstrap`.
TEA_AMO_ADMIN_USERNAME=owner
TEA_AMO_ADMIN_EMAIL=owner@teaamo.local
TEA_AMO_ADMIN_PASSWORD=change-this-password
TEA_AMO_ADMIN_NAME=Owner
