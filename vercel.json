{
  "version": 2,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "public/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/assets/3d/(.*)",
      "headers": { "Cache-Control": "public, max-age=3600" },
      "continue": true
    },
    {
      "src": "/vendor/three/(.*)",
      "headers": { "Cache-Control": "public, max-age=3600" },
      "continue": true
    },
    { "src": "/", "dest": "/api/index?__path=" },
    { "src": "/index.html", "dest": "/api/index?__path=index.html" },
    { "src": "/staff/login", "dest": "/api/index?__path=staff/login" },
    { "src": "/login", "dest": "/api/index?__path=login" },
    { "src": "/admin", "dest": "/api/index?__path=admin" },
    { "src": "/server", "dest": "/api/index?__path=server" },
    { "src": "/staff", "dest": "/api/index?__path=staff" },
    { "src": "/staff.html", "dest": "/api/index?__path=staff.html" },
    { "src": "/favicon.ico", "dest": "/api/index?__path=favicon.ico" },
    { "src": "/tea-amo-floor-plan.png", "dest": "/api/index?__path=tea-amo-floor-plan.png" },
    { "src": "/api/(.*)", "dest": "/api/index?__path=api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index?__path=$1" }
  ]
}
